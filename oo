from manim import *
class Mannager(Scene):
    def construct(self):
        tex1 = Text("Definition",font_size = 75).set_color_by_gradient(BLUE, RED)
        tex2 = Text("by Felix",font_size = 30)
        group1 = VGroup(tex1,tex2).arrange(DOWN*1.5)
        self.play(Write(group1))
        self.wait()
